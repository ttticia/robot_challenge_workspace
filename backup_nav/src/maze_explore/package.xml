<?xml version="1.0"?>
<package format="3">
  <name>maze_explore</name>
  <version>0.1.0</version>
  <description>Navigation / exploration stack for the Lite3 maze run (v2). Mapping, cell-by-cell exploration, curtain and stair crossing.</description>
  <maintainer email="user@todo.todo">Tricia</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>fast_lio</exec_depend>
  <exec_depend>lite3_launcher</exec_depend>
  <exec_depend>transfer_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>scene_understanding</exec_depend>
  <exec_depend>stairs</exec_depend>
  <exec_depend>task_reporter</exec_depend>
  <exec_depend>team_perception</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
