        <collision name="c"><geometry><box><size>8.000 0.050 1.000</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.000 0.050 1.000</size></box></geometry><material><ambient>0.4 0.4 0.5 1</ambient><diffuse>0.4 0.4 0.5 1</diffuse></material></visual>
