<link name="room_w">
        <pose>-6.500 0.750 0.500 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.050 5.500 1.000</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.050 5.500 1.000</size></box></geometry><material><ambient>0.4 0.4 0.5 1</ambient><diffuse>0.4 0.4 0.5 1</diffuse></material></visual>
