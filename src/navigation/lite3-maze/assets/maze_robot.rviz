Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: 1 m grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 16
      Plane: XY
      Reference Frame: <Fixed Frame>
      Color: 100; 100; 110
    - Class: rviz_default_plugins/Map
      Name: Observed occupancy map
      Enabled: true
      Alpha: 0.7
      Draw Behind: true
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Update Topic:
        Value: /map_updates
      Use Timestamp: false
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D LiDAR
      Enabled: true
      Topic:
        Value: /livox/points
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Style: Points
      Size (Pixels): 3
      Size (m): 0.015
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/LaserScan
      Name: Horizontal LiDAR scan
      Enabled: false
      Topic:
        Value: /scan
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Color Transformer: FlatColor
      Color: 255; 190; 50
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Topic:
        Value: /plan
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Line Style: Lines
      Line Width: 0.03
      Color: 70; 235; 130
    - Class: rviz_default_plugins/Axes
      Name: Robot body frame
      Enabled: true
      Reference Frame: base_link
      Length: 0.4
      Radius: 0.015
    - Class: rviz_default_plugins/Image
      Name: Robot RGB camera
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Transport Hint: compressed
      Normalize Range: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Footprint cells target and state
      Enabled: true
      Topic:
        Value: /maze/markers
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Image
      Name: YOLO people detections
      Enabled: true
      Topic:
        Value: /maze/people/debug_image
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Transport Hint: raw

  Enabled: true
  Global Options:
    Background Color: 35; 39; 48
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Focal Point:
        X: 0.3
        Y: 1.5
        Z: 0
      Pitch: 1.1
      Yaw: -0.8
      Target Frame: map
Window Geometry:
  Height: 960
  Width: 1600
  X: 20
  Y: 20
