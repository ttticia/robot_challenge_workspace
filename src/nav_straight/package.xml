<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav_straight</name>
  <version>0.1.0</version>
  <description>Start SLAM and let Nav2 walk the Lite3 straight ahead until an obstacle is near.</description>
  <maintainer email="user@example.com">Group 4</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_velocity_smoother</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <!-- Fast-LIO odometry + /scan (~/ros2_ws). Optional: bringup:=false skips it. -->
  <exec_depend>lite3_launcher</exec_depend>
  <!-- MotionSimpleCMD for the hand-back to manual mode (~/lite3_ws). Optional at runtime. -->
  <exec_depend>transfer_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <!-- test/fake_cloud_lite3.py -->
  <test_depend>python3-numpy</test_depend>
  <test_depend>tf2_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
