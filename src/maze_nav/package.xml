<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>maze_nav</name>
  <version>0.1.0</version>
  <description>Lite3 curtain detection (curtain-only branch of maze_nav): lidar gap check (curtain_detector), lie-down inspection and a YOLO curtain model in the colour camera (curtain_yolo).</description>
  <maintainer email="ng.tricia2005@gmail.com">ngtri</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <!-- curtain_yolo: ultralytics (+ openvino for the exported model), pip, not rosdep -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
